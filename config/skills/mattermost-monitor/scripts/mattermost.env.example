# TEMPLATE -- copy to a private location and fill in. Do NOT edit this file
# with real credentials: it ships inside a skill directory that gets shared,
# copied, and read aloud in docs.
#
#   install -d -m 700 ~/.config/mattermost
#   install -m 600 /dev/null ~/.config/mattermost/mattermost.env
#   $EDITOR ~/.config/mattermost/mattermost.env
#
# Then either `source` it or let the scripts auto-load it -- they look at
# $MM_ENV, defaulting to ~/.config/mattermost/mattermost.env.

# Unproxied host -- requires auth. All reads/writes go here.
MM_BASE="https://unproxied-mattermost.int.exe.xyz"

# Proxied host -- no credentials required. Bootstrap only (create user/PAT,
# join team). Never used to read or post.
MM_PROXY_BASE="https://mattermost.int.exe.xyz"

# Personal access token for MM_ME. Treat as a password.
MM_TOKEN=""

# The bot's own user id. Posts by this id are dropped -- this is the reply-loop
# guard. Re-read it from GET /api/v4/users/me if the account is recreated.
MM_SELF_ID=""

# Username that counts as a mention during triage.
MM_ME=""

# Channels to watch, as "channel_id:Display Name", comma separated.
# Discover with: GET /api/v4/users/me/teams/$MM_TEAM_ID/channels
MM_CHANNELS=""

# Team id, needed to add newly created accounts.
MM_TEAM_ID=""

# Poller state directory (events.jsonl, seen.txt, replied.txt, state.json).
MM_DIR="$HOME/mm-monitor"

# Poll interval in seconds.
MM_POLL=5

# This skill's scripts/ directory. Adjust if you installed the skill elsewhere;
# every example command in SKILL.md goes through it.
MM_SCRIPTS="$HOME/.config/opencode/skills/mattermost-monitor/scripts"